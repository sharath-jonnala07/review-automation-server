# Application
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/pulse.db

# LLM — use one valid remote provider for production/demo runs
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Or use OpenAI-compatible production config instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_COST_USD=0.50
LLM_TEMPERATURE=0.3
LLM_ALLOW_HEURISTIC_FALLBACK=false
LLM_ALLOW_HEURISTIC_AUTH_FALLBACK=false

# Embeddings — free local Hugging Face model by default
EMBEDDING_BACKEND=huggingface-local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Hosted Hugging Face inference API alternative:
# EMBEDDING_BACKEND=huggingface-api
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference/models
# Also required if you set LLM_PROVIDER=openai
OPENAI_API_KEY=

# The first clustering run downloads the Hugging Face model to your local cache.
# Optional cache controls:
# HF_HOME=
# HUGGINGFACE_HUB_CACHE=

# MCP Servers (required for phases 5-6)
DOCS_MCP_URL=http://localhost:5000
GMAIL_MCP_URL=http://localhost:5001
CONFIRM_SEND=false

# CORS
# Comma-separated frontend origins. Example for Fly:
# ALLOWED_ORIGINS=https://pulse-agent-web.fly.dev,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional regex for preview/prod hosts, e.g. ^https://.*\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Docs MCP credentials
GOOGLE_APPLICATION_CREDENTIALS=
# Or GOOGLE_SERVICE_ACCOUNT_JSON={...json...}
# Or GOOGLE_SERVICE_ACCOUNT_JSON_B64=<base64-encoded-json>

# Gmail SMTP MCP credentials
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pulse-agent
LANGSMITH_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=

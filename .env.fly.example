DEBUG=false
DATABASE_URL=sqlite+aiosqlite:////data/pulse.db

LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_COST_USD=0.50
LLM_TEMPERATURE=0.3
LLM_ALLOW_HEURISTIC_FALLBACK=true
LLM_ALLOW_HEURISTIC_AUTH_FALLBACK=false

EMBEDDING_BACKEND=huggingface-api
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference/models
MIN_REVIEWS_PER_RUN=200
MAX_REVIEWS_PER_RUN=200

DOCS_MCP_URL=http://pulse-agent-docs.internal:5000
GMAIL_MCP_URL=http://pulse-agent-gmail.internal:5001
CONFIRM_SEND=true

ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pulse-agent
LANGSMITH_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=